---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const entry = (await getEntry("homepage", "-index")) as CollectionEntry<"homepage">;
const { banner, feature, call_to_action } = entry.data;

const entryPoints = [
  {
    title: "SAGE",
    href: "https://sage.org.ai/",
    description: "Agent、RAG、工作流、评测与服务编排的长期组织。",
  },
  {
    title: "DataSys",
    href: "https://datasys.sage.org.ai/",
    description: "流、动态图、向量索引、在线更新、查询与基准系统。",
  },
  {
    title: "vLLM-HUST",
    href: "https://github.com/vllm-hust",
    description: "模型运行时、KV/cache 调度、编译、内核与硬件执行。",
  },
  {
    title: "IntelliStream GitHub",
    href: "https://github.com/intellistream",
    description: "仍在孵化的研究项目、公开协作与毕业记录。",
  },
];
---

<Base
  title="IntelliStream | Research Incubator"
  description="IntelliStream incubates cross-layer systems research and graduates mature projects to SAGE, DataSys, and vLLM-HUST."
>
  <section class="section pb-0">
    <div class="container">
      <div class="row items-center">
        <div class="col-12 lg:col-7">
          {banner?.subtitle && (
            <p class="mb-3 font-semibold uppercase tracking-wide text-primary">
              {banner.subtitle}
            </p>
          )}
          {banner?.title && <h1 class="mb-6" set:html={markdownify(banner.title)} />}
          {banner?.content && (
            <p class="mb-8 text-lg" set:html={markdownify(banner.content)} />
          )}
          <div class="flex flex-wrap gap-4">
            {banner?.button?.enable && (
              <a class="btn btn-primary" href={banner.button.link}>
                {banner.button.label}
              </a>
            )}
            <a class="btn btn-secondary" href="https://github.com/intellistream">
              View GitHub
            </a>
          </div>
        </div>
        {banner?.image && (
          <div class="col-12 mt-10 lg:col-5 lg:mt-0">
            <img
              src={banner.image}
              alt="IntelliStream overview"
              class="mx-auto w-full max-w-[480px]"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="text-center">
        <h2 class="mb-4" set:html={markdownify(feature.title)} />
      </div>
      <div class="row mt-8">
        {feature.features.map((item) => (
          <div class="col-12 mb-6 md:col-6 xl:col-4">
            <div class="feature-card card h-full">
              {item.icon && (
                <img src={item.icon} alt="" class="mb-5 h-12 w-12" />
              )}
              <h3 class="h4 mb-3">{item.name}</h3>
              {item.content && <p class="mb-0">{item.content}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="text-center">
        <h2 class="mb-4">Project Graduation Destinations</h2>
        <p class="mx-auto max-w-[760px]">
          IntelliStream spans the layers as a research incubator. Mature projects move to the
          organization that owns their long-term technical boundary.
        </p>
      </div>
      <div class="row mt-8">
        {entryPoints.map((item) => (
          <div class="col-12 mb-6 md:col-6 xl:col-3">
            <div class="card h-full">
              <h3 class="h4 mb-3">{item.title}</h3>
              <p>{item.description}</p>
              <a class="btn btn-secondary mt-4" href={item.href}>
                Open
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {call_to_action && (
    <section class="section">
      <div class="container">
        <div class="row items-center">
          <div class="col-12 lg:col-7">
            {call_to_action.title && (
              <h2 class="mb-4" set:html={markdownify(call_to_action.title)} />
            )}
            {call_to_action.content && (
              <div class="content mb-6" set:html={markdownify(call_to_action.content)} />
            )}
            {call_to_action.button?.enable && (
              <a class="btn btn-primary" href={call_to_action.button.link}>
                {call_to_action.button.label}
              </a>
            )}
          </div>
          <div class="col-12 mt-10 lg:col-5 lg:mt-0">
            <img
              src={call_to_action.image}
              alt="IntelliStream collaboration"
              class="mx-auto w-full max-w-[420px]"
            />
          </div>
        </div>
      </div>
    </section>
  )}
</Base>
