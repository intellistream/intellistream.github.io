---
import Base from "@/layouts/Base.astro";

const reviewProjects = [
  { name: "sageVDB", role: "Vector database core", status: "split review", category: "data", href: "https://github.com/intellistream/sageVDB" },
  { name: "sageTSDB", role: "Time-series data core", status: "split review", category: "data", href: "https://github.com/intellistream/sageTSDB" },
  { name: "sageData", role: "General data-management core", status: "split review", category: "data", href: "https://github.com/intellistream/sageData" },
  { name: "sage-anns", role: "Unified ANNS interface", status: "split review", category: "data", href: "https://github.com/intellistream/sage-anns" },
  { name: "brisksnapshot-ui", role: "Research-system interface", status: "boundary review", category: "interface", href: "https://github.com/intellistream/brisksnapshot-ui" },
  { name: "harbor", role: "Early public research artifact", status: "clarify", category: "research", href: "https://github.com/intellistream/harbor" },
  { name: "multicodex", role: "Early public research artifact", status: "clarify", category: "research", href: "https://github.com/intellistream/multicodex" },
  { name: "OmniBenchmark", role: "Historical benchmark suite", status: "archived", category: "archive", href: "https://github.com/intellistream/OmniBenchmark" },
];

const destinations = [
  { index: "01", name: "RIDE Lab", role: "Agent-native systems", detail: "Agent systems research and stewardship of the shared SAGE core.", href: "https://ride-lab.github.io/", accent: "cyan" },
  { index: "02", name: "DataSys", role: "Evolving data systems", detail: "Streams, dynamic graphs, vectors, indexes, updates, queries, and benchmarks.", href: "https://datasys.sage.org.ai/", accent: "green" },
  { index: "03", name: "vLLM-HUST", role: "Inference + hardware", detail: "Model runtime, KV/cache scheduling, compilation, kernels, and accelerators.", href: "https://vllm-hust.sage.org.ai/", accent: "amber" },
];
---

<Base
  title="IntelliStream | Research Incubator"
  description="IntelliStream incubates cross-layer systems research and graduates mature projects to RIDE Lab, DataSys, and vLLM-HUST."
  image="/images/ecosystem-infrastructure.png"
>
  <script is:inline>document.body.classList.add("ecosystem-home");</script>
  <div class="incubator-home">
    <section class="portal-hero" aria-labelledby="page-title">
      <div class="portal-hero-visual" aria-hidden="true">
        <svg viewBox="0 0 980 820" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="incubator-flow" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#f0b341"/><stop offset=".52" stop-color="#39c6ca"/><stop offset="1" stop-color="#a8d951"/>
            </linearGradient>
            <radialGradient id="incubator-glow">
              <stop offset="0" stop-color="#f0b341" stop-opacity=".32"/><stop offset="1" stop-color="#f0b341" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <g class="incubator-grid"><path d="M40 110H940M40 230H940M40 350H940M40 470H940M40 590H940M40 710H940M140 40V780M300 40V780M460 40V780M620 40V780M780 40V780"/></g>
          <circle class="incubator-halo" cx="542" cy="405" r="310" fill="url(#incubator-glow)"/>
          <g class="incubator-orbits"><circle cx="542" cy="405" r="112"/><circle cx="542" cy="405" r="214"/><circle cx="542" cy="405" r="306"/></g>
          <g class="incubator-paths" fill="none" stroke="url(#incubator-flow)">
            <path d="M160 650C260 650 302 560 362 494S468 430 542 405"/>
            <path d="M542 405C650 396 665 232 806 190"/>
            <path d="M542 405C662 420 720 430 872 405"/>
            <path d="M542 405C640 474 695 590 820 662"/>
          </g>
          <g class="incubator-nodes">
            <circle cx="160" cy="650" r="8"/><circle cx="362" cy="494" r="6"/><circle class="core" cx="542" cy="405" r="17"/>
            <circle class="destination cyan" cx="806" cy="190" r="11"/><circle class="destination green" cx="872" cy="405" r="11"/><circle class="destination amber" cx="820" cy="662" r="11"/>
          </g>
          <g class="incubator-labels"><text x="118" y="682">EXPLORE / 00</text><text x="752" y="162">RIDE / 01</text><text x="806" y="382">DATA / 02</text><text x="754" y="700">INFER / 03</text></g>
        </svg>
      </div>
      <div class="portal-hero-shade"></div>
      <div class="portal-hero-copy">
        <p class="portal-signal"><span></span> Intelligent systems ecosystem / 00</p>
        <h1 id="page-title">IntelliStream</h1>
        <p class="portal-kicker">Where systems research earns its boundary.</p>
        <p class="portal-summary">A cross-layer incubator for ideas that are still discovering their public abstraction, maintainers, evaluation path, and durable technical home.</p>
        <div class="portal-actions">
          <a class="portal-button primary" href="#pipeline">See the graduation path <span aria-hidden="true">↓</span></a>
          <a class="portal-button quiet" href="https://github.com/intellistream">Open GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <dl class="portal-metrics" aria-label="Incubator overview">
        <div><dt>03</dt><dd>destinations</dd></div>
        <div><dt>04</dt><dd>graduation gates</dd></div>
        <div><dt>∞</dt><dd>cross-layer ideas</dd></div>
      </dl>
    </section>

    <section class="portal-scope" aria-label="Incubator scope">
      <span data-code="01">State-aware orchestration</span>
      <span data-code="02">Inference-state management</span>
      <span data-code="03">Hardware-aware inference</span>
      <span data-code="04">Open systems research</span>
    </section>

    <section class="portal-section portal-dark" id="pipeline">
      <div class="portal-section-head">
        <div><p class="portal-eyebrow">Incubation protocol</p><h2>Explore broadly. Graduate deliberately.</h2></div>
        <p>IntelliStream is not a fourth runtime layer. It is the side rail that lets early work cross layers before ownership becomes stable.</p>
      </div>
      <div class="stage-grid">
        <article><span>01 / EXPLORE</span><strong>Research question</strong><p>Validate the problem, collaborators, and cross-layer opportunity.</p></article>
        <article><span>02 / STABILIZE</span><strong>Public abstraction</strong><p>Name the boundary, maintainers, interfaces, and evaluation contract.</p></article>
        <article><span>03 / VERIFY</span><strong>Reproducible path</strong><p>Document setup, tests, licensing, releases, and sustainable ownership.</p></article>
        <article><span>04 / GRADUATE</span><strong>Durable home</strong><p>Move to RIDE Lab, DataSys, or vLLM-HUST according to technical scope.</p></article>
      </div>
    </section>

    <section class="portal-section portal-dark" id="sage">
      <div class="portal-section-head">
        <div><p class="portal-eyebrow">Shared flagship product</p><h2>SAGE connects the ecosystem.</h2></div>
        <p>Streaming-Augmented Generative Execution applies streaming-computing principles to LLM inference and agent execution. RIDE Lab stewards the core; DataSys and vLLM-HUST retain their own data-system and inference boundaries.</p>
      </div>
      <div class="stage-grid">
        <article><span>01 / VISION</span><strong>Stream-first execution</strong><p>Make dataflow, state, backpressure, and continuous execution explicit.</p></article>
        <article><span>02 / STEWARD</span><strong>RIDE Lab</strong><p>Maintains the SAGE core repositories and agent-facing product surfaces.</p></article>
        <article><span>03 / DATA</span><strong>DataSys</strong><p>Owns framework-neutral stream, graph, vector, index, and evolving-data systems.</p></article>
        <article><span>04 / INFER</span><strong>vLLM-HUST</strong><p>Owns model execution, scheduling, compilation, kernels, and hardware backends.</p></article>
      </div>
      <div class="portal-actions"><a class="portal-button primary" href="https://sage.org.ai/">Open SAGE <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="portal-section destinations">
      <div class="portal-section-head">
        <div><p class="portal-eyebrow">Graduation destinations</p><h2>Three mature organizations.</h2></div>
        <p>The destinations form a layered intelligent-systems ecosystem. Research directions remain cross-cutting overlays.</p>
      </div>
      <div class="destination-grid">
        {destinations.map((item) => (
          <a class={`destination ${item.accent}`} href={item.href}>
            <span>{item.index}</span><small>{item.role}</small><h3>{item.name}</h3><p>{item.detail}</p><em>Open destination ↗</em>
          </a>
        ))}
      </div>
    </section>

    <section class="portal-section public-review" id="review">
      <div class="portal-section-head">
        <div><p class="portal-eyebrow">Public boundary review</p><h2>Visible work still in formation.</h2></div>
        <p>These repositories are intentionally not treated as graduated products. Status labels describe the next ownership decision.</p>
      </div>
      <div class="review-list">
        {reviewProjects.map((project) => (
          <a class="review-row" href={project.href}>
            <span class="review-name">{project.name}</span>
            <span class="review-role">{project.role}</span>
            <span class={`review-status status-${project.status.replace(" ", "-")}`}>{project.status}</span>
            <span class="review-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="portal-section portal-architecture" id="ecosystem">
      <div class="portal-section-head">
        <div><p class="portal-eyebrow">Shared architecture</p><h2>Incubation spans every layer.</h2></div>
        <p>Graduation arrows point outward. IntelliStream does not keep writable mirrors of projects after they move.</p>
      </div>
      <div class="architecture-grid">
        <a class="active" href="#page-title"><span>00</span><strong>IntelliStream</strong><small>Cross-layer research incubator</small></a>
        <a href="https://ride-lab.github.io/"><span>01</span><strong>RIDE Lab</strong><small>Agent systems and SAGE core stewardship</small></a>
        <a href="https://datasys.sage.org.ai/"><span>02</span><strong>DataSys</strong><small>Streams, graphs, vectors, indexes</small></a>
        <a href="https://vllm-hust.sage.org.ai/"><span>03</span><strong>vLLM-HUST</strong><small>Runtime, scheduling, kernels, hardware</small></a>
      </div>
    </section>
  </div>
</Base>
